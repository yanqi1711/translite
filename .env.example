# 翻译服务提供商：lara 或 baidu（默认 lara）
TRANSLATION_PROVIDER=lara

# LARA翻译API配置（TRANSLATION_PROVIDER=lara 时必填）
# 请访问 https://developers.laratranslate.com/ 获取API密钥
LARA_ACCESS_KEY_ID=你的LARA_ACCESS_KEY_ID
LARA_ACCESS_KEY_SECRET=你的LARA_ACCESS_KEY_SECRET

# 百度翻译API配置（TRANSLATION_PROVIDER=baidu 时必填）
# 请访问 https://fanyi-api.baidu.com/ 获取 appid 和密钥
BAIDU_APP_ID=你的BAIDU_APP_ID
BAIDU_SECRET_KEY=你的BAIDU_SECRET_KEY
